{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GOST Schematic CAD - Desktop IPC Preview",
  "version": "0.1.0",
  "identifier": "dev.gostschematic.desktop.ipc",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../editor",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../editor"
    },
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../editor/dist",
    "additionalWatchFolders": [
      "../../editor/src"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GOST CAD Desktop IPC Preview",
        "width": 900,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173 https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/engine-bridge"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      },
      "allowDowngrades": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
