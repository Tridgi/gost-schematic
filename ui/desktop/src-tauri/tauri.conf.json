{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GOST Schematic CAD - Desktop IPC Preview",
  "version": "0.1.0",
  "identifier": "dev.gostschematic.desktop.ipc",
  "build": {"frontendDist": "../dev-preview"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "main", "title": "GOST CAD Desktop IPC Preview", "width": 900, "height": 600}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/engine-bridge"],
    "windows": {"webviewInstallMode": {"type": "offlineInstaller"}}
  }
}
